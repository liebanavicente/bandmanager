# Base de datos
DATABASE_URL="postgresql://bandmanager:bandmanager@localhost:5432/bandmanager?schema=public"

# Auth.js
AUTH_SECRET="cambia-este-secreto-en-produccion"
AUTH_URL="http://localhost:3000"

# Archivos: con un almacén Vercel Blob conectado van a Blob (privado). Vercel
# crea BLOB_STORE_ID (credenciales OIDC) al conectarlo; también vale el
# BLOB_READ_WRITE_TOKEN clásico. Sin ninguno, al disco local.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Email por SMTP (recuperar contraseña y avisos de feedback).
# Gratis con Gmail: activa la verificación en 2 pasos y crea una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords
# Sin SMTP_HOST los emails solo se escriben en el log.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
# A quién avisar de cada feedback del piloto (vacío = solo se guarda en BD)
FEEDBACK_NOTIFY_EMAIL=""

# Integraciones futuras (simuladas en desarrollo)
WOOCOMMERCE_URL=""
WOOCOMMERCE_CONSUMER_KEY=""
WOOCOMMERCE_CONSUMER_SECRET=""
GELATO_API_KEY=""
GELATO_STORE_ID=""

# Entorno
NODE_ENV="development"